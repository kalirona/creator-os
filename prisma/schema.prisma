// CreatorOS — Multi-tenant creator platform schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  avatarUrl     String?
  bio           String?
  role          String   @default("OWNER") // global account role
  credits       Int      @default(500)
  passwordHash  String?  // nullable for OAuth-only users
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   WorkspaceMember[]
  posts         CommunityPost[]
  comments      CommunityComment[]
  enrollments   Enrollment[]
  orders        Order[]
  aiConversations AiConversation[]
  creditTxns    CreditTransaction[]
  aiGenerations AiGeneration[]
  sessions      Session[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  activityLogs  ActivityLog[]
  mediaAssets   MediaAsset[]
  communityMembers CommunityMember[]
  communitySpaceMembers CommunitySpaceMember[]
  communityEventAttendees CommunityEventAttendee[]
  emailVerifications EmailVerification[]
  passwordResets PasswordReset[]
  invitationsSent Invitation[]
}

model Workspace {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logoUrl       String?
  plan          String   @default("PRO") // FREE | PRO | SCALE | ENTERPRISE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       WorkspaceMember[]
  courses       Course[]
  products      Product[]
  posts         CommunityPost[]
  communityPosts Post[] @relation("WorkspacePosts")
  communities Community[] @relation("CommunityWorkspace")
  communityReactions Reaction[] @relation("WorkspaceReactions")
  communityUserBadges CommunityUserBadge[]
  communityComments Comment[]
  communityMembers CommunityMember[]
  communitySpaces CommunitySpace[]
  communitySpaceMembers CommunitySpaceMember[]
  communityEvents CommunityEvent[]
  communityEventAttendees CommunityEventAttendee[]
  communityInvitations CommunityInvitation[]
  communityBadges CommunityBadge[]
  communityNotifications CommunityNotification[]
  communityReports CommunityReport[]
  communityResources CommunityResource[]
  communityAnnouncements CommunityAnnouncement[]
  customers     Customer[]
  mediaAssets   MediaAsset[]
  mediaFolders  MediaFolder[]
  emailCampaigns EmailCampaign[]
  affiliates    Affiliate[]
  pages         WebPage[]
  memberships   MembershipPlan[]
  invitations   Invitation[]
}

model WorkspaceMember {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String
  role         String   @default("MEMBER") // OWNER|ADMIN|MANAGER|INSTRUCTOR|MODERATOR|MEMBER|STUDENT|AFFILIATE|GUEST
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Course {
  id           String   @id @default(cuid())
  workspaceId  String
  title        String
  description  String
  thumbnailUrl String?
  category     String   @default("Marketing")
  price        Float    @default(0)
  level        String   @default("BEGINNER") // BEGINNER|INTERMEDIATE|ADVANCED
  status       String   @default("PUBLISHED") // DRAFT|PUBLISHED|ARCHIVED
  rating       Float    @default(0)
  studentsCount Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sections     Section[]
  enrollments  Enrollment[]
}

model Section {
  id          String   @id @default(cuid())
  courseId     String
  title       String
  position    Int      @default(0)
  lessons     Lesson[]

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Lesson {
  id          String   @id @default(cuid())
  sectionId   String
  title       String
  content     String
  type        String   @default("VIDEO") // VIDEO|TEXT|PDF|AUDIO|QUIZ
  duration    Int      @default(0) // minutes
  position    Int      @default(0)
  isPreview   Boolean  @default(false)

  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  progress    Float    @default(0)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Product {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  description  String
  coverUrl     String?
  type         String   @default("DIGITAL") // DIGITAL|BUNDLE|MEMBERSHIP|COURSE
  price        Float
  compareAt    Float?
  fileUrl      String?
  salesCount   Int      @default(0)
  rating       Float    @default(0)
  status       String   @default("ACTIVE") // ACTIVE|DRAFT|ARCHIVED
  createdAt    DateTime @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders       Order[]
}

model Order {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String
  productId    String?
  amount       Float
  currency     String   @default("USD")
  status       String   @default("COMPLETED") // PENDING|COMPLETED|REFUNDED|FAILED
  customerEmail String
  customerName String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model CommunityPost {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String
  category     String   @default("General")
  title        String
  content      String
  likesCount   Int      @default(0)
  commentsCount Int     @default(0)
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments     CommunityComment[]
}

model CommunityComment {
  id          String   @id @default(cuid())
  postId      String
  userId      String
  content     String
  createdAt   DateTime @default(now())

  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  email        String
  tags         String   @default("")
  ltv          Float    @default(0)
  ordersCount  Int      @default(0)
  status       String   @default("ACTIVE") // ACTIVE|CHURNED|LEAD
  createdAt    DateTime @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model EmailCampaign {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  subject      String
  previewText  String    @default("")
  body         String    @default("")
  type         String    @default("BROADCAST") // BROADCAST|AUTOMATION|SEQUENCE
  status       String    @default("DRAFT") // DRAFT|SCHEDULED|SENT
  audience     String    @default("ALL") // ALL|STUDENTS|CUSTOMERS|MEMBERS
  recipients   Int       @default(0)
  openRate     Float     @default(0)
  clickRate    Float     @default(0)
  sentAt       DateTime?
  scheduledAt  DateTime?
  createdBy     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model Affiliate {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  email        String
  code         String   @unique
  clicks       Int      @default(0)
  conversions  Int      @default(0)
  earnings     Float    @default(0)
  commissionRate Float  @default(0.3)
  status       String   @default("ACTIVE")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WebPage {
  id           String   @id @default(cuid())
  workspaceId  String
  title        String
  slug         String
  type         String   @default("LANDING") // LANDING|SALES|HOME|ABOUT|CONTACT|BLOG|PRICING
  status       String   @default("PUBLISHED")
  visits       Int      @default(0)
  createdAt    DateTime @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model MembershipPlan {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  price        Float
  interval     String   @default("MONTHLY") // MONTHLY|YEARLY|LIFETIME
  members      Int      @default(0)
  status       String   @default("ACTIVE")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AiConversation {
  id           String   @id @default(cuid())
  userId       String
  tool         String   @default("CHAT") // CHAT|COURSE|LESSON|EMAIL|SALES|BLOG|SOCIAL|SCRIPT
  title        String
  messages     String   @default("[]") // JSON array
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  amount       Int      // negative = spent, positive = purchased
  reason       String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===== AI Platform (database-driven, admin-managed) =====

model AiProvider {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  apiKey      String   @default("")
  baseUrl     String   @default("")
  isActive    Boolean  @default(true)
  priority    Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  models      AiModel[]
}

model AiModel {
  id           String   @id @default(cuid())
  providerId   String
  name         String   // internal id
  displayName  String
  contextWindow Int     @default(128000)
  isDefault    Boolean  @default(false)
  costMultiplier Float  @default(1.0)
  isActive     Boolean  @default(true)

  provider     AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model AiTool {
  id           String   @id @default(cuid())
  slug         String   @unique // COURSE_GENERATOR | EMAIL_WRITER | ...
  name         String
  description  String
  icon         String   @default("Sparkles")
  category     String   @default("Content") // Content | Courses | Marketing | Sales | Strategy
  systemPrompt String   @default("")
  userInputPrompt String @default("") // template injected with user input
  creditCost   Int      @default(5)
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(4000)
  outputType   String   @default("MARKDOWN") // MARKDOWN | COURSE | LESSON | EMAIL | SALES_PAGE | BLOG | SOCIAL | SCRIPT | PRODUCT | LANDING
  isVisible    Boolean  @default(true)
  isPro        Boolean  @default(false)
  outputSchema String   @default("") // JSON schema hint for structured outputs
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  generations  AiGeneration[]
}

model AiGeneration {
  id           String   @id @default(cuid())
  userId       String
  toolId       String
  toolSlug     String
  title        String
  input        String   @default("") // user prompt
  output       String   @default("") // raw AI text
  structured   String   @default("{}") // JSON structured output (course obj, etc.)
  status       String   @default("COMPLETED") // PENDING | COMPLETED | FAILED
  creditsUsed  Int      @default(0)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool         AiTool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  enabled     Boolean  @default(true)
  workspaceId String?  // null = global flag
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([key])
}

model Cache {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @default("") // serialized value
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@index([key])
}

model AdminSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @default("")
  category    String   @default("general") // general | billing | ai | storage | email
  updatedAt   DateTime @updatedAt
}

// ===== Auth Extensions =====

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  email     String
  token     String   @unique
  expiresAt DateTime
  verifiedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Invitation {
  id           String   @id @default(cuid())
  workspaceId  String
  inviterId    String
  inviteeEmail String
  role         String   @default("MEMBER")
  token        String   @unique
  status       String   @default("PENDING") // PENDING | ACCEPTED | EXPIRED | REVOKED
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([token])
}

// ===== Pages & Funnels system =====

model Page {
  id           String   @id @default(cuid())
  workspaceId  String
  title        String
  slug         String
  type         String   @default("PAGE") // PAGE | LANDING | FUNNEL_STEP | BLOG | HOME | ABOUT | CONTACT | LEGAL | THANK_YOU
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | SCHEDULED
  category     String   @default("General") // for landing pages: Course | Membership | Product | Community | Agency | SaaS | LeadMagnet | Newsletter | Webinar | Coaching
  funnelId     String?
  seoTitle     String   @default("")
  seoDescription String @default("")
  ogImage      String   @default("")
  schema       String   @default("{}")
  visits       Int      @default(0)
  conversions  Int      @default(0)
  publishedAt  DateTime?
  scheduledAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sections     PageSection[]
  versions     PageVersion[]
  funnelSteps  FunnelStep[]
}

model PageSection {
  id          String   @id @default(cuid())
  pageId      String
  type        String   // HERO | FEATURES | BENEFITS | PRICING | TESTIMONIALS | FAQ | VIDEO | GALLERY | COUNTDOWN | CTA | NEWSLETTER | FOOTER | TEXT | HEADING
  content     String   @default("{}") // JSON content
  position    Int      @default(0)
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  version     Int
  sections    String   @default("[]") // JSON snapshot of sections
  note        String   @default("")
  createdAt   DateTime @default(now())

  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Funnel {
  id           String   @id @default(cuid())
  workspaceId  String
  slug         String   @unique @default(cuid())
  name         String
  description  String   @default("")
  type         String   @default("SALES") // SALES | LEAD | WEBINAR | LAUNCH
  status       String   @default("DRAFT") // DRAFT | LIVE | PAUSED
  visits       Int      @default(0)
  conversions  Int      @default(0)
  revenue      Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  steps         FunnelStep[]
  customDomains CustomDomain[]
}

model FunnelStep {
  id          String   @id @default(cuid())
  funnelId    String
  pageId      String?
  name        String
  type        String   // LANDING | CHECKOUT | UPSELL | DOWNSELL | THANK_YOU | EMAIL | COMMUNITY_INVITE | COURSE_ACCESS
  position    Int      @default(0)
  isRequired  Boolean  @default(true)

  funnel      Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  page        Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
}

model CustomDomain {
  id           String   @id @default(cuid())
  workspaceId  String
  domain       String   @unique
  funnelId     String?
  status       String   @default("PENDING") // PENDING | VERIFIED | ACTIVE | FAILED
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  funnel       Funnel?  @relation(fields: [funnelId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([funnelId])
}

model BlogPost {
  id           String   @id @default(cuid())
  workspaceId  String
  title        String
  slug         String
  excerpt      String   @default("")
  content      String   @default("")
  coverUrl     String   @default("")
  category     String   @default("General")
  tags         String   @default("")
  author       String   @default("Alex Rivera")
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | SCHEDULED
  seoTitle     String   @default("")
  seoDescription String @default("")
  visits       Int      @default(0)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @default("")
  category    String   @default("brand") // brand | header | footer | analytics | seo | domains
  updatedAt   DateTime @updatedAt
}

// ===== Auth: Sessions, Refresh Tokens, Audit & Activity Logs =====

model Session {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String?
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  revokedAt    DateTime?
  replacedById String?  // points to the next token in rotation

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id])
  replacedByOf RefreshToken[] @relation("TokenRotation")

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  action      String   // e.g. "user.login", "course.create", "payment.refund"
  resource    String?  // e.g. "User", "Course", "Order"
  resourceId  String?
  metadata    String   @default("{}") // JSON: { before, after, ip, userAgent }
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  action      String   // e.g. "started_editing", "saved_content", "published_course"
  description String   @default("")
  metadata    String   @default("{}") // JSON: { resourceId, resourceType, details }
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

// ===== Media Asset Management =====

model MediaFolder {
  id          String   @id @default(cuid())
  workspaceId String
  parentId    String?
  name        String
  slug        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent     MediaFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   MediaFolder[] @relation("FolderTree")
  assets     MediaAsset[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, parentId])
}

model MediaAsset {
  id          String   @id @default(cuid())
  workspaceId String
  folderId    String?
  userId      String?
  fileName    String
  originalName String
  mimeType    String
  fileSize    Int      // bytes
  width       Int?
  height      Int?
  duration    Float?   // seconds for video/audio
  thumbnailUrl String?
  url         String
  altText     String   @default("")
  caption     String   @default("")
  description String   @default("")
  isPublic    Boolean  @default(false)
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  folder     MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  usages     MediaUsage[]

  @@index([workspaceId, folderId])
  @@index([workspaceId, mimeType])
  @@index([workspaceId, createdAt])
}

model MediaUsage {
  id          String   @id @default(cuid())
  assetId     String
  workspaceId String
  resourceType String  // course | product | page | blog_post | email | community_post
  resourceId  String
  field       String   // e.g. "thumbnail", "content", "video"
  createdAt   DateTime @default(now())

  asset      MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, resourceType, resourceId, field])
  @@index([resourceType, resourceId])
}

// ===== Community Module =====

model Community {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String   @default("")
  bio         String   @default("")
  iconUrl     String?
  bannerUrl   String?
  privacy     String   @default("PUBLIC") // PUBLIC | PRIVATE | SECRET
  memberApproval String @default("AUTO") // AUTO | MANUAL | APPROVAL_REQUIRED
  allowPosting String  @default("ALL") // ALL | MEMBERS_ONLY | MODERATORS_ONLY
  allowMedia  Boolean  @default(true)
  maxFileSize Int      @default(10485760) // 10MB
  allowComments Boolean @default(true)
  allowReactions Boolean @default(true)
  allowInvites Boolean  @default(true)
  allowSearch Boolean   @default(true)
  allowRSS    Boolean   @default(false)
  color       String   @default("#2563eb")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace @relation("CommunityWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  spaces     CommunitySpace[]
  posts      Post[]
  members    CommunityMember[]
  events     CommunityEvent[]
  eventAttendees CommunityEventAttendee[]
  invitations CommunityInvitation[]
  badges     CommunityBadge[]
  userBadges   CommunityUserBadge[]
  notifications CommunityNotification[]
  reports    CommunityReport[]
  resources  CommunityResource[]
  announcements CommunityAnnouncement[]
  comments     Comment[]
  reactions    Reaction[] @relation("CommunityReactions")
  spaceMembers CommunitySpaceMember[] @relation("CommunitySpaceMembers")

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model CommunityMember {
  id          String   @id @default(cuid())
  communityId String
  userId      String
  workspaceId String
  role        String   @default("MEMBER") // OWNER | ADMIN | MODERATOR | MEMBER | GUEST
  status      String   @default("ACTIVE") // ACTIVE | PENDING | SUSPENDED | BANNED
  reputation  Int      @default(0)
  points      Int      @default(0)
  level       Int      @default(1)
  bio         String   @default("")
  avatarUrl   String?
  coverUrl    String?
  website     String?
  socialLinks String   @default("{}") // JSON: { twitter: "", linkedin: "", etc. }
  badges      String   @default("[]") // JSON array of badge IDs
  coursesCompleted Int @default(0)
  productsPurchased Int @default(0)
  joinedAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community  Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  postAuthor Post[]
  commentAuthor Comment[]
  reactions   Reaction[]
  invitationsSent CommunityInvitation[]
  reportsAuthored CommunityReport[]
  organizedEvents CommunityEvent[]
  resources   CommunityResource[]
  announcements CommunityAnnouncement[]
  awardedBadges CommunityUserBadge[] @relation("BadgeRecipient")
  awardedBadgesTo CommunityUserBadge[] @relation("BadgeAwarder")
  notifications CommunityNotification[]

  @@unique([communityId, userId])
  @@index([communityId, role])
  @@index([communityId, status])
  @@index([communityId, reputation])
}

model CommunitySpace {
  id          String   @id @default(cuid())
  communityId String
  workspaceId String
  name        String
  slug        String
  description String   @default("")
  iconUrl     String?
  bannerUrl   String?
  color       String   @default("#2563eb")
  privacy     String   @default("PUBLIC") // PUBLIC | PRIVATE | SECRET
  isPinned    Boolean  @default(false)
  sortOrder   Int      @default(0)
  rules       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community  Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members    CommunitySpaceMember[]
  posts      Post[]
  events     CommunityEvent[]
  resources  CommunityResource[]

  @@unique([communityId, slug])
  @@index([communityId])
}

model CommunitySpaceMember {
  id          String   @id @default(cuid())
  spaceId     String
  communityId String
  userId      String
  workspaceId String
  role        String   @default("MEMBER") // OWNER | MODERATOR | MEMBER
  joinedAt    DateTime @default(now())

  space      CommunitySpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  community  Community      @relation("CommunitySpaceMembers", fields: [communityId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([spaceId, role])
}

model Post {
  id          String   @id @default(cuid())
  communityId String
  workspaceId String
  spaceId     String?
  authorId    String
  type        String   @default("TEXT") // TEXT | IMAGE | VIDEO | DOCUMENT | POLL | QUESTION | ANNOUNCEMENT | EVENT | AI_GENERATED
  title       String?
  content     String   @default("")
  mediaIds    String   @default("[]") // JSON array of media asset IDs
  pollOptions String   @default("[]") // JSON array for poll options
  pollVotes   String   @default("{}") // JSON map of option index to vote count
  isPinned    Boolean  @default(false)
  isLocked    Boolean  @default(false)
  isDraft     Boolean  @default(false)
  isScheduled Boolean  @default(false)
  scheduledAt DateTime?
  publishedAt DateTime?
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  commentCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community  Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  workspace  Workspace   @relation("WorkspacePosts", fields: [workspaceId], references: [id], onDelete: Cascade)
  space      CommunitySpace? @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  author     CommunityMember @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments   Comment[]
  reactions  Reaction[]
  notifications CommunityNotification[]
  reports    CommunityReport[]

  @@index([communityId, createdAt])
  @@index([communityId, spaceId])
  @@index([communityId, type])
  @@index([authorId])
}

model Comment {
  id          String   @id @default(cuid())
  postId      String
  communityId String
  workspaceId String
  authorId    String
  parentId    String?  // for nested replies
  content     String
  mentions    String   @default("[]") // JSON array of mentioned user IDs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community  Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post       Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     CommunityMember @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     Comment?    @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]   @relation("Thread")
  reactions  Reaction[]
  reports    CommunityReport[]

  @@index([postId, createdAt])
  @@index([postId, parentId])
}

model Reaction {
  id          String   @id @default(cuid())
  postId      String?
  commentId   String?
  communityId String
  workspaceId String
  userId      String
  type        String   // LIKE | LOVE | CELEBRATE | INSIGHTFUL | FUNNY
  createdAt   DateTime @default(now())

  community  Community   @relation("CommunityReactions", fields: [communityId], references: [id], onDelete: Cascade)
  workspace  Workspace   @relation("WorkspaceReactions", fields: [workspaceId], references: [id], onDelete: Cascade)
  user       CommunityMember @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    Comment?    @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@unique([commentId, userId])
  @@index([communityId])
}

model CommunityEvent {
  id          String   @id @default(cuid())
  communityId String
  workspaceId String
  spaceId     String?
  organizerId String
  title       String
  description String   @default("")
  location    String   @default("")
  meetingUrl  String?
  startsAt    DateTime
  endsAt      DateTime
  type        String   @default("MEETUP") // MEETUP | WEBINAR | OFFICE_HOURS | PRODUCT_LAUNCH | COURSE_RELEASE
  maxAttendees Int?
  waitlistEnabled Boolean @default(false)
  reminderSent Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community  Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  space      CommunitySpace? @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  organizer  CommunityMember @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  attendees  CommunityEventAttendee[]

  @@index([communityId, startsAt])
  @@index([communityId, type])
}

model CommunityEventAttendee {
  id          String   @id @default(cuid())
  eventId     String
  communityId String
  workspaceId String
  userId      String
  status      String   @default("GOING") // GOING | MAYBE | WAITLIST | DECLINED
  rsvpAt      DateTime @default(now())

  event      CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  community  Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status])
}

model CommunityInvitation {
  id          String   @id @default(cuid())
  communityId String
  workspaceId String
  inviterId   String
  inviteeEmail String
  inviteeName String?
  role        String   @default("MEMBER")
  spaceId     String?
  token       String   @unique
  status      String   @default("PENDING") // PENDING | ACCEPTED | EXPIRED | REVOKED
  expiresAt   DateTime
  sentAt      DateTime @default(now())
  respondedAt DateTime?
  createdAt   DateTime @default(now())

  community  Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter    CommunityMember @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([communityId, status])
  @@index([token])
}

model CommunityBadge {
  id          String   @id @default(cuid())
  communityId String
  workspaceId String
  name        String
  description String   @default("")
  iconUrl     String?
  color       String   @default("#2563eb")
  criteria    String   @default("") // JSON criteria for auto-award
  isAuto      Boolean  @default(false)
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())

  community  Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  awardedTo  CommunityUserBadge[]

  @@index([communityId])
}

model CommunityUserBadge {
  id          String   @id @default(cuid())
  badgeId     String
  communityId String
  workspaceId String
  userId      String
  awardedBy   String?  // user ID who awarded it manually
  reason      String   @default("")
  createdAt   DateTime @default(now())

  badge      CommunityBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  community  Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       CommunityMember @relation("BadgeRecipient", fields: [userId], references: [id], onDelete: Cascade)
  awardedByMember CommunityMember? @relation("BadgeAwarder", fields: [awardedBy], references: [id], onDelete: SetNull)

  @@index([communityId, userId])
}

model CommunityNotification {
  id          String   @id @default(cuid())
  communityId String
  workspaceId String
  userId      String
  postId      String?
  type        String   // MENTION | REPLY | LIKE | NEW_FOLLOWER | ANNOUNCEMENT | EVENT_REMINDER | POST_APPROVED
  title       String
  body        String   @default("")
  link        String?  // URL to the relevant resource
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  community  Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       CommunityMember @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       Post?         @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([communityId, userId, isRead])
  @@index([communityId, createdAt])
}

model CommunityReport {
  id          String   @id @default(cuid())
  communityId String
  workspaceId String
  reporterId  String
  postId      String?
  commentId   String?
  reason      String
  description String   @default("")
  status      String   @default("PENDING") // PENDING | REVIEWED | RESOLVED | DISMISSED
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  community  Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reporter   CommunityMember @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  post       Post?           @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment    Comment?        @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([communityId, status])
  @@index([communityId, createdAt])
}

model CommunityResource {
  id          String   @id @default(cuid())
  communityId String
  workspaceId String
  spaceId     String?
  authorId    String
  title       String
  description String   @default("")
  fileUrl     String
  fileName    String
  fileSize    Int
  mimeType    String
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community  Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  space      CommunitySpace? @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  author     CommunityMember @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
  @@index([communityId, spaceId])
}

model CommunityAnnouncement {
  id          String   @id @default(cuid())
  communityId String
  workspaceId String
  authorId    String
  title       String
  content     String
  isPinned    Boolean  @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community  Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author     CommunityMember @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([communityId, startsAt])
  @@index([communityId, isPinned])
}

